//        $("#detailfxCn").val(period.extendedProps.fxCn);
//        $("#detailfxPlace").val(period.extendedProps.fxPlace);
		document.getElementById("detailempId").value = period.extendedProps.empId;
		document.getElementById("detailfxSj").value = period.title;
		document.getElementById("detailfxIem").value = period.extendedProps.fxIem;
		document.getElementById("detailfxBeginDt").value = period.startStr.substring(0, 16);
		document.getElementById("detailfxEndDt").value = period.endStr.substring(0, 16);
		document.getElementById("detailfxCn").value = period.extendedProps.fxCn;
		document.getElementById("detailfxPlace").value = period.extendedProps.fxPlace;

       //모달 띄우기 바닐라 js로 변경했습니다.kbh
       $("#detailModal").modal('show');
// 		modal.show();
       
   });
   // 캘린더 그리기
   calendar.render();
   }); //전체 끝
 </script>
