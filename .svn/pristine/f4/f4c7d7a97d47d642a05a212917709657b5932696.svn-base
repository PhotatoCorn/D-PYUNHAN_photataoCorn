<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<%@ include file="./include/headerContents.jsp" %>

<script type="text/javascript" src="/js/jquery-3.6.0.js"></script>

<!-- ///// content 시작 ///// -->
<section class="d-flex justify-content-center align-items-center"
         style="min-height: calc(100vh - 120px);
                background: linear-gradient(135deg, #c2e9fb 0%, #a1c4fd 100%);
                overflow: hidden;">
  <div class="card shadow-lg border-0" style="border-radius:1rem; max-width:400px; width:90%; background-color:#fff;">
    <div class="card-body p-5 text-center">
      <h2 class="fw-bold text-primary mb-3">입주민 로그인</h2>
      <p class="text-muted mb-4">우리 아파트 서비스를 이용하시려면 로그인해주세요</p>

      <form action="/login" method="POST">
        <div class="mb-3 text-start">
          <label class="form-label text-black fw-semibold">ID</label>
          <input type="text" class="form-control" name="username" placeholder="아이디를 입력하세요" required />
        </div>

        <div class="mb-3 text-start">
          <label class="form-label text-black fw-semibold">Password</label>
          <input type="password" class="form-control" name="password" placeholder="비밀번호를 입력하세요" required />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
          로그인 <i class="bi bi-box-arrow-in-right"></i>
        </button>
      </form>

      <button type="button" class="btn btn-outline-secondary w-100 mt-3 py-2" onclick="location.href='/signup'">
        회원가입
      </button>
    </div>
  </div>
</section>
<!-- ///// content 끝 ///// -->

<!-- 로그인 페이지 접속 시 세션스토리지 초기화 -->
<script>
sessionStorage.removeItem('initialNtcnShown');
sessionStorage.removeItem('lastLoggedInUser');
</script>

<%@ include file="./include/footerContents.jsp" %>   