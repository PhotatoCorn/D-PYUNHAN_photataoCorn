<!-- /.mobile-frame -->

</body>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const frame  = document.querySelector('.mobile-frame');
  const header = frame?.querySelector('#header');
  if (!frame || !header) return;

  const TH = 60; //스크롤 크기만큼 미리 스크롤 내려놓는효과
  const onScroll = () => {
    header.classList.toggle('scrolled', frame.scrollTop > TH);
  };

  // 초기 상태 반영 + 스크롤 이벤트 등록
  onScroll();
  frame.addEventListener('scroll', onScroll, {passive:true});

  // 모바일 메뉴 열릴 때는 불투명 유지
  const navToggle = header.querySelector('.mobile-nav-toggle');
  if (navToggle) {
    navToggle.addEventListener('click', () => {
      const isActive = document.body.classList.contains('mobile-nav-active');
      header.classList.toggle('nav-open', !isActive);
    });
  }
});



const frame = document.querySelector('.mobile-frame');
if (frame) {
  frame.addEventListener('scroll', () => AOS.refresh());
}
document.addEventListener("DOMContentLoaded", function() {
    AOS.init({
      once: false,          // true면 한 번만, false면 스크롤마다 다시
      duration: 800,        // 애니메이션 시간
      easing: 'ease-out'
    });
  });
  

</script>

<!-- BJW추가 script -->
<sec:authorize access="isAuthenticated()">
	<sec:authentication property="principal.mberVO" var="mberVO" />
</sec:authorize>
<script>
let stompClient = null;

const user = "${mberVO.mberId}";
const group = "${mberVO.aptcmpl}";
const userAll = "ALL_MBER";

const gContextPath = "${pageContext.request.contextPath}";

function connectWebSocket() {
	const socket = new SockJS(gContextPath + "/ws-ntcn");
	stompClient = Stomp.over(socket);

	const rcverIds = [user, group, userAll];
	
	stompClient.connect({}, function(frame) {
		console.log("Connected: " + frame);

		rcverIds.forEach(id => {
			stompClient.subscribe("/topic/ntcn/" + id, function(message) {
				const ntcn = JSON.parse(message.body);
				showNtcnSwal(ntcn);
			});
			console.log("Subscribed: /topic/ntcn/" + id);
		});
	});
}

function showNtcnSwal(ntcn) {
	const icons = {
		CVPL: "info",
		RESVE: "success",
		ELCTRNSANCTN: "info",
		NOTICE: "info",
		FCLTY: "info",
		BBS: "info",
		VOTE: "info",
		MANAGECT: "warning",
		SYSTEM: "error"
	};

	const titles = {
		CVPL: "민원 알림",
		RESVE: "예약 알림",
		ELCTRNSANCTN: "결재 알림",
		NOTICE: "공지 알림",
		FCLTY: "시설 알림",
		BBS: "게시판 알림",
		VOTE: "투표 알림",
		MANAGECT: "관리비 알림",
		SYSTEM: "시스템 알림"
	};

	const messages = {
		CVPL: ntcn.ntcnCn,
		RESVE: ntcn.ntcnCn,
		ELCTRNSANCTN: ntcn.ntcnCn,
		NOTICE: ntcn.ntcnCn,
		FCLTY: ntcn.ntcnCn,
		BBS: ntcn.ntcnCn,
		VOTE: ntcn.ntcnCn,
		MANAGECT: ntcn.ntcnCn,
		SYSTEM: ntcn.ntcnCn
	};

	const icon = icons[ntcn.ntcnTy] || "info";
	const title = titles[ntcn.ntcnTy] || "알림";
	const message = messages[ntcn.ntcnTy] || "새로운 알림이 도착했습니다.";

	Swal.fire({
		icon: icon,
		title: title,
		html: message,
		footer: `<a href="\${ntcn.ntcnUrl}">자세히 보기</a>`
	});
}

document.addEventListener("DOMContentLoaded", connectWebSocket);
</script>
<!-- BJW추가끝 -->

</html>

















