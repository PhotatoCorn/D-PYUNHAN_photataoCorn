								        <i class="bi bi-chevron-right toggle-dropdown"></i>
								    </a>
									<ul>
										<li class="dropdown open-right">
								            <a href="/bbs/bbsGroupList"> <i class="bi bi-list"></i>&nbsp;게시판</a>
								        </li>
									</ul>
							    </li>
								<li><a href="/vote/memVoteList"><i class="bi bi-ui-checks-grid"></i>&nbsp;주민 투표</a></li>
							</ul>
						</li>
					</ul>
				</nav>

				<!-- 로고 -->
				<a href="/main" class="brand-link d-flex align-items-center gap-2 text-decoration-none">
					<img src="/images/logo1.png" alt="로고"
					class="brand-image img-circle elevation-3"
					style="width: 75px; height: 75px; object-fit: cover;">
				</a>
				
<!-- <nav id="navmenu" class="navmenu"> -->
