<!-- 				로그인 / 로그아웃 -->
				<nav id="user-menu">
				    <ul>
				        <li class="dropdown">
				            <sec:authorize access="isAuthenticated()">
				                <sec:authentication property="principal.mberVO" var="mberVO" />
				                <a href="#" class="user-profile">
								    <div class="user-circle">
								        ${fn:substring(mberVO.mberNm, 1, 3)}
								    </div>
								    <i class="bi bi-chevron-down toggle-dropdown"></i>
								</a>
				                <ul class="dropdown-menu-box">
				                    <li>
				                        <a href="/mypage/info">
				                            <i class="bi bi-person"></i>
				                            <span>내 정보</span>
				                        </a>
				                    </li>
				                    <li>
				                        <form action="/logout" method="post" >
				                            <button type="submit">
				                                <i class="bi bi-box-arrow-right"></i><span>로그아웃</span>
				                            </button>
				                        </form>
				                    </li>
				                </ul>
				            </sec:authorize>
				
				            <sec:authorize access="isAnonymous()">
				                <a href="/login" class="btn">로그인</a>
				            </sec:authorize>
				        </li>
				    </ul>
				</nav>


			</div>
			<!-- /.container-fluid -->
		</header>
		<!-- /header -->
		<!-- =============== /Dewi Header =============== -->
<script>
document.addEventListener("DOMContentLoaded", () => {
    const li = document.querySelector("#header-navmenu .dropdown");

    li.addEventListener("mouseenter", () => {
        li.classList.add("open");
    });

    li.addEventListener("mouseleave", () => {
        li.classList.remove("open");
    });
    
    const right = document.querySelector("#user-menu .dropdown");

    right.addEventListener("mouseenter", () => {
        right.classList.add("open");
    });

    right.addEventListener("mouseleave", () => {
        right.classList.remove("open");
    });
});

</script>

